# PostgreSQL Connection String (Vercel Postgres, Neon, Supabase, AWS RDS, etc.)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Session Cookies
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Application URL
NEXT_PUBLIC_APP_URL="https://your-deployment-url.vercel.app"
